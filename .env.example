# FactoryMind AI Configuration
# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL / Supabase or local SQLite fallback)
# If DATABASE_URL is unset, the system automatically falls back to local SQLite:
# sqlite+aiosqlite:///./factorymind.db
DATABASE_URL=sqlite+aiosqlite:///./factorymind.db

# Supabase (Optional Direct Integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Simulation Configuration
SIMULATION_TICK_RATE_MS=1000
DEFAULT_UNIT_ID=1
