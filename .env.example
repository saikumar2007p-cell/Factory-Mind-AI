# FactoryMind AI Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL / Supabase or local SQLite fallback)
# If DATABASE_URL is unset, the system automatically falls back to local SQLite:
# sqlite+aiosqlite:///./factorymind.db
DATABASE_URL=sqlite+aiosqlite:///./factorymind.db

# Supabase (LEGACY — being migrated to Firebase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Admin SDK (Backend Only — NEVER expose to frontend)
# Download service account JSON from: Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=backend/firebase_service_account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Auth Mode: FIREBASE (production) or DEVELOPMENT (header-based fallback)
FIREBASE_AUTH_MODE=DEVELOPMENT

# Frontend Firebase Web SDK (set these in frontend/.env.local — NOT here)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Simulation Configuration
SIMULATION_TICK_RATE_MS=1000
DEFAULT_UNIT_ID=1

# Dataset Configuration
# Active datasets are auto-discovered from data/raw/ directories
# Supported: NASA_CMAPSS_FD001, PHM_2009_GEARBOX, PHMAP_2023_VALVE
DEFAULT_DATASET=NASA_CMAPSS_FD001
